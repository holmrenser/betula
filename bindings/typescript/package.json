{
  "name": "betula",
  "version": "0.5.0",
  "description": "TypeScript types and runtime parsers for the betula bioinformatics JSON schemas",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"test/*.test.mjs\" && npm run example",
    "example": "tsc -p tsconfig.examples.json && node build/examples/usage.js"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "^7.0.2"
  }
}
